# Shopify Admin API
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_your_access_token
SHOPIFY_API_VERSION=2026-01
SHOPIFY_DURATION_MS=5000

# ApiHasav / source API
API_BASE_URL=https://api.example.com
API_TOKEN=your_api_token
API_DURATION_MS=10000

# Price sync / Markets
# Leave international values empty to use app defaults.
SHOPIFY_BASE_CURRENCY=ILS
SHOPIFY_INTERNATIONAL_MARKET_HANDLE=
SHOPIFY_INTERNATIONAL_MARKET_NAME=
SHOPIFY_INTERNATIONAL_CATALOG_TITLE=
SHOPIFY_INTERNATIONAL_PRICE_LIST_NAME=

# Inventory tracking
# SKU prefixes that must NOT get Shopify inventory tracking. These are the ERP
# service/placeholder items that carry no stock and must stay buyable (tracking them
# would pin them at quantity 0). Comma separated; defaults to ZZ- when unset.
# Set to an empty value to track every SKU.
SHOPIFY_UNTRACKED_SKU_PREFIXES=ZZ-

# Stock sync
# SYNC_STOCK_MODE values: full (default), delta
#   full  - push the whole ERP feed. SKUs Shopify already holds at the right quantity
#           are skipped without a write. This is the reconciliation pass: Shopify's
#           on_hand also moves on its own when an order is fulfilled, and only a full
#           run notices the ERP number needs re-pushing. Keep it on a daily schedule.
#   delta - push only SKUs whose ERP quantity changed since the last successful run,
#           diffed against SYNC_STOCK_STATE_FILE. Cheap enough for a */5 cron, which is
#           what takes the storefront from ~6 hours stale down to ~5 minutes.
# An unrecognised value falls back to full: pushing too much is slow, pushing too
# little oversells.
SYNC_STOCK_MODE=full
# Where the delta snapshot of last-pushed quantities lives. Defaults to
# stock-state.json inside LOG_FILE_DIR, which is the volume-mounted directory in the
# container, so it survives the one-shot docker run. Deleting it just makes the next
# delta run push everything once.
SYNC_STOCK_STATE_FILE=
# Resolve everything, write nothing. Every read still happens, so the log and the
# emailed CSV list each SKU that WOULD move (before -> after) plus the tracking and
# activation writes that were withheld. The snapshot is not updated either, so a dry run
# cannot make the next real delta believe those quantities were already pushed.
# Use this to review a change before it touches the live storefront:
#   SYNC_ONLY_STEPS=syncStocks SYNC_STOCK_DRY_RUN=true go run ./cmd/sync-stock-and-price
# Covers the stock step only — the product sync still writes.
SYNC_STOCK_DRY_RUN=false

# Logging
# LOG_OUTPUT values: stdout, telegram, both, none
# NOTE: telegram alerts only fire when this is set to telegram or both. Leaving it
# unset (the default) means the TELEGRAM_* credentials below are never used.
LOG_OUTPUT=stdout
LOG_FILE_DIR=logs
TELEGRAM_CHAT_ID=
TELEGRAM_TOKEN=

# Email report
# Every run emails a report of what actually changed in Shopify (stock and price
# before -> after per SKU, new products, failures) with the full list attached as CSV.
# It is sent on failure too, so an empty inbox means the scheduled job never started.
# Verify the settings without running a sync: go run ./cmd/send-test-report
REPORT_EMAIL_ENABLED=true
REPORT_EMAIL_TO=first@example.com,second@example.com
# Rows inlined per table in the email body; the CSV attachment always has them all.
REPORT_MAX_ROWS=50
# Suppress the mail when a run succeeded and changed nothing. Leave false for the daily
# full sync: an empty inbox is how you find out the scheduler is dead.
REPORT_EMAIL_ONLY_ON_CHANGE=false
# Suppress the mail unless a step actually failed. Overrides ONLY_ON_CHANGE when both
# are set, and is what the */5 delta cron uses (see deploy/run-shopify-exporter.sh).
# ONLY_ON_CHANGE alone was not enough there: a live catalogue moves at least one SKU on
# nearly every tick, so it still sent ~288 mails a day. With this the inbox gets one
# scheduled mail a day, from the daily full run, plus anything that actually broke.
REPORT_EMAIL_ONLY_ON_FAILURE=false
REPORT_TIMEZONE=Asia/Jerusalem

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=orders@example.com
SMTP_PASSWORD=change_me
# Defaults to SMTP_USERNAME when empty.
SMTP_FROM=
SMTP_FROM_NAME=Shopify Sync
SMTP_TIMEOUT_MS=30000
# Defaults to true for port 465 (implicit TLS), false elsewhere (STARTTLS).
SMTP_IMPLICIT_TLS=
# Escape hatch for a broken relay certificate. Leave false.
SMTP_SKIP_TLS_VERIFY=false

# Optional debug filters
# Comma, semicolon, pipe, or newline separated.
SYNC_ONLY_STEPS=
SYNC_ONLY_SKUS=
SYNC_TRACE_SKUS=

# Required only for cmd/sync-orders.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=shopify_exporter
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=shopify_exporter
